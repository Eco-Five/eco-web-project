<link rel="stylesheet" href="/styles/board/board.css">
    <div class="container mt-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3">커뮤니티</h1>
            
        </div>

        <div class="row">
            <!-- 카테고리 선택-->
            <div class="col-lg-8">
                <div class="mb-3 d-flex justify-content-between">
                    <select class="form-select w-auto">
                        <option selected>전체</option>
                        <option value="1">환경뉴스</option>
                        <option value="2">친환경팁</option>
                        <option value="3">자유게시판</option>
                    </select>
                    <a href="/board/write"><button class="btn btn-dark">글쓰기</button></a>
                </div>
                <!-- 카테고리 선택-->

                <!-- 커뮤니티 글 목록 -->
                <div class="list-group">
                    <% boards.forEach(board => { %>
                        <a href="/board/read?b_no=<%= board.board_id %>" class="list-group-item list-group-item-action d-flex gap-3 py-3">
                            <img src="<%= board.image_url || 'https://placehold.co/180x100' %>" alt="thumbnail" class="rounded">
                            <div class="w-100">
                                <h5 class="mb-1"><%= board.title %></h5>
                                <p class="mb-1 text-truncate"><%= board.content %></p>
                                <small class="text-muted"><%= board.name %> · <%= formatDate(board.board_date) %> · <i class="bi bi-eye"></i> 165 · <i class="bi bi-suit-heart"></i> 28</small>
                            </div>
                        </a>
                    <% }) %>
                </div>
                <!-- 커뮤니티 글 목록 -->

                <!-- 페이지 -->
                <nav class="mt-4">
                    <ul class="pagination justify-content-center">
                        <li class="page-item"><a class="page-link" href="#"><</a></li>
                        <li class="page-item"><a class="page-link" href="#">1</a></li>
                        <li class="page-item active"><a class="page-link" href="#">2</a></li>
                        <li class="page-item"><a class="page-link" href="#">3</a></li>
                        <li class="page-item"><a class="page-link" href="#">></a></li>
                    </ul>
                </nav>
                <!-- 페이지 -->
            </div>

            <!-- 사이드바(인기게시글) -->
            <div class="col-lg-4">
                <h5>인기 게시글</h5>
                    <ul class="list-group">
                        <li class="list-group-item d-flex justify-content-between align-items-start">
                            <div class="ms-2 me-auto">
                                <div>1. 이달의 환경을 위한 팁</div>
                            </div>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-start">
                            <div class="ms-2 me-auto">
                                <div>2. 플라스틱 줄이기 실천 방법</div>
                            </div>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-start">
                            <div class="ms-2 me-auto">
                                <div>3. 바자회 후기</div>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
            <!-- 인기게시글 -->
        </div>
    </div>


<% 
function formatDate(dateStr) {
    const date = new Date(dateStr);
    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, '0');  // months are zero-indexed
    const day = String(date.getDate()).padStart(2, '0');
    const hours = String(date.getHours()).padStart(2, '0');
    const minutes = String(date.getMinutes()).padStart(2, '0');
    
    return `${year}.${month}.${day} ${hours}:${minutes}`;
}
%>


