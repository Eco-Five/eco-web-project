<div class="container mt-5">
    <!-- 게시글 상세 -->
    <div class="card p-4 mb-4">
        <h1 class="h4" id="board-title"></h1>
        <small class="text-muted" id="board-meta"></small>
        <p class="mt-3" style="white-space: pre-line;" id="board-content"></p>
        <div class="d-flex justify-content-between align-items-center mt-4">
            <!-- 좋아요 버튼 -->
            <button id="like" class="btn btn-outline-primary">
                <i class="bi" id="like-icon"></i>  
                <span id="heart-count"></span>
            </button>
            <div>
                <button class="btn btn-outline-primary btn-sm me-2" id="btn-update"><i class="bi bi-pencil"></i> 수정</button>
                <button class="btn btn-outline-danger btn-sm me-2" id="btn-delete"><i class="bi bi-trash"></i> 삭제</button>
                <button class="btn btn-outline-primary btn-sm me-2" id="btn-list"><i class="bi bi-list"></i> 목록</button>
            </div>
        </div>
    </div>
</div>

<script>
    console.log("Logged-in User:", "<%= user ? user.member_id : 'No User' %>");
    document.addEventListener('DOMContentLoaded', async () => {
        // 서버에서 전달된 게시글 번호 및 로그인한 사용자 member_id
        const b_no = "<%= b_no %>";
        const loggedInUser = "<%= user ? user.member_id : '' %>";  // 로그인한 사용자 member_id
        
        // 게시글 데이터 로드
        const renderBoardData = async () => {
            try {
                const response = await fetch(`/api/board/${b_no}`);
                const result = await response.json();

                if (result.success) {
                    const board = result.board;

                    document.getElementById('board-title').textContent = board.title;
                    document.getElementById('board-meta').textContent = 
                        `${board.name} · ${formatDate(board.board_date)} · 조회수 ${board.view_count}`;
                    document.getElementById('board-content').textContent = board.content;
                    document.getElementById('heart-count').textContent = board.totalhearts;

                    // 좋아요 아이콘 설정
                    const likeIcon = document.getElementById('like-icon');
                    likeIcon.className = board.heart === 1 ? 'bi-suit-heart-fill' : 'bi-suit-heart';

                    // 작성자와 로그인한 사용자가 다르면 수정/삭제 버튼 숨김
                    if (String(loggedInUser).trim() !== String(board.member_id).trim()) {
                        document.getElementById('btn-update').style.display = 'none';
                        document.getElementById('btn-delete').style.display = 'none';
                    }
                } else {
                    alert('게시글을 불러오는 데 실패했습니다.');
                }
            } catch (error) {
                console.error('오류 발생:', error);
                alert('게시글을 불러오는 중 오류가 발생했습니다.');
            }
        };

        // 목록으로 이동
        document.querySelector("#btn-list").addEventListener("click", () => {
            location.href = "/board";
        });

        // 게시글 수정 페이지 이동
        document.querySelector("#btn-update").addEventListener("click", () => {
            location.href = `/board/update/${b_no}`;
        });

        // 게시글 삭제
        document.querySelector("#btn-delete").addEventListener("click", async () => {
            if (confirm("정말 삭제하시겠습니까?")) {
                try {
                    const response = await fetch(`/api/board/${b_no}`, {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ b_no: b_no })
                    });

                    const data = await response.json();
                    if (data.success) {
                        alert("삭제 완료되었습니다.");
                        location.href = "/board";
                    } else {
                        alert("삭제 실패했습니다.");
                    }
                } catch (error) {
                    console.error("오류 발생: ", error);
                    alert("오류가 발생했습니다.");
                }
            }
        });

        // 좋아요 버튼 클릭 시 처리
        document.querySelector("#like").addEventListener("click", async () => {
            try {
                const response = await fetch(`/api/board/${b_no}/like`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                });
                // 비로그인 상태
                if (response.status === 401) {
                    alert("로그인이 필요합니다.");
                    return;
                }

                const data = await response.json();
                if (data.totalHearts !== undefined) {
                    document.querySelector("#heart-count").textContent = data.totalHearts;
                    const newIconClass = data.totalHearts > 0 ? 'bi-suit-heart-fill' : 'bi-suit-heart';
                    document.querySelector("#like i").className = 'bi ' + newIconClass;
                }
            } catch (error) {
                console.error("오류 발생: ", error);
            }
        });

        // 데이터 렌더링 실행
        renderBoardData();
    });

    // 날짜 포맷팅 함수
    const formatDate = (dateStr) => {
        const date = new Date(dateStr);
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');
        const hours = String(date.getHours()).padStart(2, '0');
        const minutes = String(date.getMinutes()).padStart(2, '0');
        return `${year}.${month}.${day} ${hours}:${minutes}`;
    };
</script>