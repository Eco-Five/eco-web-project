<div class="container mt-5">
    <h1 class="mb-4">공지사항수정</h1>

    <div class="mb-3">
        <label for="category" class="form-label"><strong>Category</strong></label>
        <select id="category" name="category" class="form-select" required>
            <option value="서비스공지" <%= notice.category === '서비스공지' ? 'selected' : '' %>>서비스공지</option>
            <option value="업데이트" <%= notice.category === '업데이트' ? 'selected' : '' %>>업데이트</option>
        </select>
    </div>

    <div class="mb-3">
        <label for="title" class="form-label"><strong>Title</strong></label>
        <input type="text" id="title" name="title" class="form-control" value="<%= notice.title %>" required>
    </div>

    <div class="mb-3">
        <label for="content" class="form-label"><strong>Content</strong></label>
        <textarea id="content" name="content" class="form-control" rows="5" required><%= notice.content %></textarea>
    </div>

    <div class="d-flex justify-content-between">
        <a href="/notice" class="btn btn-secondary" id="btn-list">Back to List</a>
        <button class="btn btn-success" id="btn-update">Update</button>
    </div>
</div>

<script>
    $(document).ready(() => {
        // 취소 버튼 클릭 시 목록 페이지로 이동
        $("#btn-list").click(() => {
            location.href = "/notice";
        });

        // 수정 버튼 클릭 시 폼 데이터를 서버로 전송
        $("#btn-update").click((event) => {
            event.preventDefault(); // 버튼 기본 동작 방지

            const b_no = "<%= notice.notice_id %>";
            const payload = {
                b_no,
                category: $("#category").val(), // 카테고리
                title: $("#title").val(),       // 제목
                content: $("#content").val(),   // 내용
            };

            // 서버로 AJAX 요청
            $.ajax({
                url: `/api/notice/update/${b_no}`, // 서버의 수정 API 경로
                type: "PUT",
                contentType: "application/json", // JSON 데이터로 설정
                data: JSON.stringify(payload),   // JSON 형식으로 데이터 전송
                beforeSend: function () {
                    $("#btn-update").prop("disabled", true); // 버튼 비활성화
                },
                success: function (response) {
                    if (response.success) {
                        alert("수정 완료되었습니다.");
                        location.href = "/notice"; // 수정 성공 시 목록 페이지로 이동
                    } else {
                        alert("수정 실패했습니다.");
                    }
                },
                error: function (xhr, status, error) {
                    alert("오류 발생: " + error);
                },
                complete: function () {
                    $("#btn-update").prop("disabled", false); // 버튼 활성화
                },
            });
        });
    });
</script>
