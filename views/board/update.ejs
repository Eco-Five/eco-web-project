<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>공지사항 수정</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body>
    <div class="container my-5">
        <!-- Header -->
        <header class="d-flex align-items-center mb-4">
            <h1 class="mb-0">공지사항 수정</h1>
        </header>

        <!-- Update Form -->
        <form action="/notice/update/<%= notice.id %>" method="POST" class="mb-5">
            <!-- Category -->
            <div class="mb-3">
                <label for="category" class="form-label">카테고리</label>
                <select name="category" id="category" class="form-select">
                    <option value="일반공지" <%= notice.category === '일반공지' ? 'selected' : '' %>>일반공지</option>
                    <option value="이벤트" <%= notice.category === '이벤트' ? 'selected' : '' %>>이벤트</option>
                    <option value="시스템점검" <%= notice.category === '시스템점검' ? 'selected' : '' %>>시스템점검</option>
                </select>
            </div>

            <!-- Title -->
            <div class="mb-3">
                <label for="title" class="form-label">제목</label>
                <input type="text" name="title" id="title" class="form-control" value="<%= notice.title %>" required>
            </div>

            <!-- Content -->
            <div class="mb-3">
                <label for="content" class="form-label">내용</label>
                <textarea name="content" id="content" rows="5" class="form-control" required><%= notice.content %></textarea>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn btn-primary">수정하기</button>
            <a href="/notice" class="btn btn-secondary">취소</a>
        </form>
    </div>
</body>
</html>
