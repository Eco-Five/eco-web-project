<link rel="stylesheet" href="/styles/board/board.css">
    <div class="container mt-5">
        <div class="card">
            <div class="card-header text-white bg-dark">
                <div class="align-items-center">
                    <h4 class="mb-0">커뮤니티</h4>
                    <p class="mb-0">친환경적인 미래를 위해 의견을 공유해보세요</p>
                </div>
            </div>
            <div class="card-body">
                <form>
                    <div class="mb-3">
                        <label for="category" class="form-label">카테고리</label>
                        <select id="category" class="form-select">
                            <option selected>커뮤니티 유형을 선택하세요</option>
                            <option value="1">친환경뉴스</option>
                            <option value="2">친환경팁</option>
                            <option value="3">자유게시판</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="title" class="form-label">작성자</label>
                        <input type="text" class="form-control" id="member_id" value="<%= user ? user.member_id : '' %>" hidden>
                        <input type="text" class="form-control" value="<%= user ? user.name : '' %>" readonly>
                    </div>
                    <div class="mb-3">
                        <label for="title" class="form-label">제목</label>
                        <input type="text" class="form-control" id="title" placeholder="제목을 입력하세요" >
                    </div>
                    <div class="mb-3">
                        <label for="content" class="form-label">내용</label>
                        <textarea class="form-control" id="content" rows="20" placeholder="내용을 입력하세요"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="fileUpload" class="form-label">파일 첨부</label>
                        <input class="form-control" type="file" id="fileUpload" accept=".png, .jpg, .gif">
                        <small class="text-muted">PNG, JPG, GIF 최대 10MB</small>
                    </div>
                    <div class="d-flex justify-content-end">
                        <button type="button" class="btn btn-secondary me-2" id="btn-list">취소</button>
                        <button type="submit" class="btn btn-primary" id="btn-write">등록</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            // 취소 버튼 클릭 시 목록 페이지로 이동
            document.getElementById("btn-list").addEventListener("click", () => {
                location.href = "/board"; 
            });
    
            // 등록 버튼 클릭 시 폼 데이터를 서버로 전송
            document.getElementById("btn-write").addEventListener("click", async (event) => {
                event.preventDefault();  // 폼 제출을 막고 fetch로 처리
    
                // FormData 객체 생성
                const formData = new FormData();
                formData.append('member_id', document.getElementById("member_id").value);  // 세션값 전송 확인
                formData.append('content_type_id', document.getElementById("category").value);  // 카테고리
                formData.append('title', document.getElementById("title").value);  // 제목
                formData.append('content', document.getElementById("content").value);  // 내용
    
                // 파일 첨부가 있는지 확인하고, 파일이 있으면 파일을 formData에 추가
                const fileUpload = document.getElementById("fileUpload").files[0];
                if (fileUpload) {
                    formData.append('fileUpload', fileUpload);
                }
    
                try {
                    // 서버로 fetch 요청 보내기
                    const response = await fetch('/api/board/write', {
                        method: 'POST',
                        body: formData,  // FormData 객체 전달
                    });
    
                    const result = await response.json();  // 응답 결과를 JSON으로 파싱
    
                    if (result.success) {
                        alert("등록 완료되었습니다.");
                        window.location.href = "/board";  // 등록 성공 시 목록 페이지로 이동
                    } else {
                        alert("카테고리를 선택하세요.");
                    }
                } catch (error) {
                    alert("카테고리를 선택하세요");
                    console.error("등록 요청 중 오류 발생:", error);
                }
            });
        });
    </script>