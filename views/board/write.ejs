<link rel="stylesheet" href="/styles/board/board.css">
    <div class="container mt-5">
        <div class="card">
            <div class="card-header text-white bg-dark">
                <div class="align-items-center">
                    <h4 class="mb-0">커뮤니티</h4>
                    <p class="mb-0">친환경적인 미래를 위해 의견을 공유해보세요</p>
                </div>
            </div>
            <div class="card-body">
                <form>
                    <div class="mb-3">
                        <label for="category" class="form-label">카테고리</label>
                        <select id="category" class="form-select">
                            <option selected>커뮤니티 유형을 선택하세요</option>
                            <option value="1">친환경뉴스</option>
                            <option value="2">친환경팁</option>
                            <option value="3">자유게시판</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="title" class="form-label">제목</label>
                        <input type="text" class="form-control" id="title" placeholder="제목을 입력하세요" >
                    </div>
                    <div class="mb-3">
                        <label for="content" class="form-label">내용</label>
                        <textarea class="form-control" id="content" rows="20" placeholder="내용을 입력하세요"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="fileUpload" class="form-label">파일 첨부</label>
                        <input class="form-control" type="file" id="fileUpload" accept=".png, .jpg, .gif">
                        <small class="text-muted">PNG, JPG, GIF 최대 10MB</small>
                    </div>
                    <div class="d-flex justify-content-end">
                        <button type="button" class="btn btn-secondary me-2" id="btn-list">취소</button>
                        <button type="submit" class="btn btn-primary" id="btn-write">등록</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(() => {
            // 취소 버튼 클릭 시 목록 페이지로 이동
            $("#btn-list").click(() => {
                location.href = "/board"; 
            });
    
            // 등록 버튼 클릭 시 폼 데이터를 서버로 전송
            $("#btn-write").click((event) => {
                event.preventDefault();  // 폼 제출을 막고 AJAX로 처리
                
                const formData = new FormData()
                formData.append('content_type_id',$("#category").val()) // 카테고리
                formData.append('title', $("#title").val()); // 제목
                formData.append('content', $("#content").val()); // 내용
                formData.append('fileUpload',$("#fileUpload")[0].files[0])
    
                // 서버로 AJAX 요청을 보내기
                $.ajax({
                    url: '/api/board/write',  // 서버의 등록 API 경로
                    type: 'POST',
                    data: formData,
                    processData: false, //FormData 사용 시 설정
                    contentType: false, //FormData 사용 시 설정
                    success: function(response) {
                        if (response.success) {
                            alert("등록 완료되었습니다.");
                            window.location.href = "/board";  // 등록 성공 시 목록 페이지로 이동
                        } else {
                            alert("등록 실패했습니다.");
                        }
                    },
                    error: function(xhr, status, error) {
                        alert("오류 발생: " + error);
                    }
                });
            });
        });
    </script>