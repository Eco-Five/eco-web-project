<link rel="stylesheet" href="/styles/login/login.css">
<div class="d-flex min-vh-100 justify-content-center align-items-center">
    <div>
        <div class="text-center mb-4">
            <img src="images/anyone/eco-mascot.png" alt="로고" class="mb-3" style="height: 100px;">
            <h1 class="h5 fw-bold">에코라이프에 오신 것을 환영합니다</h1>
        </div>
        <form>
            <div class="mb-3 position-relative">
                <label for="email" class="form-label">이메일</label>
                <input type="email" id="email" class="form-control py-2 ps-4" placeholder="✉ 이메일을 입력하세요" required>
            </div>
            <div class="mb-3 position-relative">
                <label for="password" class="form-label">비밀번호</label>
                <input type="password" id="password" class="form-control py-2 ps-4" placeholder="🔒︎ 비밀번호를 입력하세요" required>
            </div>
            <button type="submit" class="btn btn-success w-100 custom-btn py-2">로그인</button>
            <div class="text-center mt-3">
                <a href="/login/find" class="text-decoration-none text-secondary">아이디/비밀번호 찾기</a>
            </div>
            <div class="d-flex justify-content-between">
                <button id="google-login" type="button" class="mt-3 btn w-100" style="border: 1px solid grey; background: none;">
                    <img src="images/login/google.webp" alt="Google" style="max-height: 25px; object-fit: corver;">
                    Sign up with Google
                </button>
                <div id="user-info"></div>
            </div>
        </form>
        <div class="text-center mt-4">
            <p class="text-secondary">아직 회원이 아니신가요?</p>
            <a href="/register" class="text-decoration-none text-success fw-bold">회원가입하기</a>
        </div>
        <footer class="text-center mt-4 text-secondary small">
            <div>
                <a href="#" class="text-decoration-none text-secondary me-2">이용약관</a>
                <a href="#" class="text-decoration-none text-secondary ms-2">개인정보처리방침</a>
            </div>
            <p class="mt-2 mb-0">© 2024 에코라이프. All rights reserved.</p>
        </footer>
    </div>
</div>

<script type="module">
    // firebase-config.js에서 Firebase 앱 가져오기
    import { app } from '/javascripts/firebase.js';

    // Firebase 모듈 가져오기
    import { getAuth, signInWithPopup, GoogleAuthProvider, signOut } from "https://www.gstatic.com/firebasejs/11.0.2/firebase-auth.js";

    // Firebase 인증 초기화
    const auth = getAuth(app);

    // Google 인증 제공자 설정
    const provider = new GoogleAuthProvider();

    // Google 로그인 버튼 클릭 이벤트
    document.getElementById('google-login').addEventListener('click', async () => {
        try {
            // Firebase Authentication을 사용해 Google 로그인
            const result = await signInWithPopup(auth, provider);
            const user = result.user;

            // 사용자 정보를 화면에 표시
            document.getElementById('user-info').innerHTML = `
                <p>Logged in as: ${user.displayName}</p>
                <p>Email: ${user.email}</p>
                <img src="${user.photoURL}" alt="Profile Picture" style="width:100px; height:100px;">
            `;
        } catch (error) {
            console.error("Error during login:", error);
            alert("Failed to log in. Please try again.");
        }
    });

    // 로그아웃 버튼 클릭 이벤트
    document.getElementById('logout').addEventListener('click', async () => {
        try {
            // Firebase 인증 로그아웃
            await signOut(auth);

            // 사용자 정보를 화면에서 제거
            document.getElementById('user-info').innerHTML = "<p>You have logged out.</p>";
        } catch (error) {
            console.error("Error during logout:", error);
            alert("Failed to log out. Please try again.");
        }
    });
</script>