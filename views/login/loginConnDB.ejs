<script>
    // 로그인 정보 POST API 함수
    async function loginCheck(loginInfo) {
        try {
            const response = await fetch('api/memberLogin', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(loginInfo), // 객체를 JSON 문자열로 변환하여 전송
            });
            const data = await response.json()
            console.log(data);

        } catch (error) {
            console.error('로그인 요청 중 오류 발생:', error);
            alert('로그인 요청 중 오류가 발생했습니다. 다시 시도해주세요.')
        }
    }

    const loginForm = document.getElementById('loginForm')
    // 로그인 실행문
    loginForm.addEventListener('submit', (event) => {
        event.preventDefault()

        // 로그인 정보
        const loginInfo = {
            loginEmail: document.getElementById('loginEmail').value,
            loginPwd: document.getElementById('loginPwd').value,
        }
        loginCheck(loginInfo)
    })
</script>

