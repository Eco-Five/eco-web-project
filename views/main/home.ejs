<!-- https://www.w3schools.com/bootstrap5/bootstrap_carousel.php -->
<div id="demo" class="carousel slide" data-bs-ride="carousel">

    <!-- Indicators/dots -->
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#demo" data-bs-slide-to="0" class="active"></button>
        <button type="button" data-bs-target="#demo" data-bs-slide-to="1"></button>
        <button type="button" data-bs-target="#demo" data-bs-slide-to="2"></button>
    </div>

    <!-- The slideshow/carousel -->
    <div class="carousel-inner carousel slide" data-bs-ride="carousel">
        <div class="d-flex flex-column align-items-center justify-content-center"
            style="color: white; position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); z-index: 2;">
            <h1 id="bannerTitle" class="mb-3" style="font-size: clamp(1.4rem, 4vw, 3rem);">
                지구를 위한 현명한 선택
            </h1>
            <p id="bannerText" class="mb-8" style="font-size: clamp(0.6rem, 2.0vw, 1.4rem);">
                지속 가능한 소비로 더 나은 미래를 만들어갑니다
            </p>
            <form class="d-flex" onsubmit="event.preventDefault(); window.location.href='/about';">
                <button id="bannerButton" class="btn btn-dark">시작하기</button>
            </form>
        </div>

        <div class="carousel-item active">
            <img src="/images/main/baner1.png" alt="baner1" class="d-block" style="width:100%" />
            <div
                style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.5); z-index: 1;">
            </div>
        </div>
        <div class="carousel-item">
            <img src="/images/main/baner2.png" alt="baner2" class="d-block" style="width:100%" />
            <div
                style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.5); z-index: 1;">
            </div>
        </div>
        <div class="carousel-item">
            <img src="/images/main/baner3.png" alt="baner3" class="d-block" style="width:100%" />
            <div
                style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.5); z-index: 1;">
            </div>
        </div>
    </div>

    <!-- Left and right controls/icons -->
    <button class="carousel-control-prev" type="button" data-bs-target="#demo" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#demo" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
    </button>
</div>
<!------------------------- 이미지 슬라이드 -------------------------------->



<!-------------------------- 카테고리 -------------------------------->
<div id="card-container" class="d-flex justify-content-between mt-3 mb-3"
    style="width: 100%; font-size: clamp(0.6rem, 2.0vw, 1.0rem);"></div>

<script type="module">
    const cardContainer = document.getElementById("card-container");

    for (let i = 0; i < 4; i++) {
        const cardHtml = `
        <div class="container d-flex justify-content-center">
            <div class="card" style="max-width: 450px; text-align: center">
                <img class="card-img-top img-fluid" src="images/main/zerowaste.png" alt="Card image">
                <div class="card-img-overlay">
                    <p class="card-title d-flex align-items-center justify-content-center fw-bold" 
                        style="height: 100%; font-size: clamp(1.2rem, 2vw, 3rem); color: green;">제로웨이스트</p>
                </div>
            </div>
        </div>
    `
        cardContainer.innerHTML += cardHtml;
    }

</script>
<!-------------------------- 카테고리 이동 -------------------------------->



<!-------------------------- 추천 제품 -------------------------------->
<div style="width: 100%;">
    <h2 class="text mt-5 ms-2 mb-3 fw-bold" style="font-size: clamp(1.2rem, 2vw, 3rem);">추천 제품</h2>
    <div id="products" class="d-flex justify-content-between">
        <!-- Handlebars 템플릿이 여기에 렌더링됩니다. -->
    </div>
</div>

<script id="product-card" type="text/x-handlebars-template">
    {{#each products}}
    <div class="category-cart me-2 ms-2" style="border: 1px solid #e0e0e0; border-radius: 10px; flex: 1;">
        <img class="img-fluid" src="{{image}}" alt="{{alt}}" style="width: 100%; object-fit: cover;">
        <div class="p-3">
            <span style="font-size: clamp(0.4rem, 2vw, 0.8rem);">{{mark}}</span>
            <h4 class="card-title fw-bold" style="font-size: clamp(0.6rem, 2vw, 1.5rem);">{{alt}}</h4>
            <p class="card-text" style="font-size: clamp(0.4rem, 1.5vw, 1rem);">{{description}}</p>
            <div class="d-flex justify-content-between align-items-center p-2" >
                <p class="mb-0 fw-bold" style="font-size: clamp(0.6rem, 2vw, 1.2rem);">{{price}}</p> <!-- 텍스트 크기 키움 -->
                <button index="{{@index}}" class="btn btn-dark btn-sm" style="min-width: 10px; font-size: 1vw">에코백담기</button> <!-- 버튼 크기 조정 -->
            </div>
        </div>
    </div>
    {{/each}}
</script>

<script>
    const productCard = document.getElementById("product-card").innerHTML;
    const productCardTemp = Handlebars.compile(productCard);
    const products = document.getElementById("products");
    products.innerHTML = productCardTemp(mainData);
</script>
<!-------------------------- 추천 제품 -------------------------------->



