<!-------------------------- 유튜브 -------------------------------->
<h2 class="text mt-5 ms-2 mb-3 fw-bold" style="font-size: clamp(1.2rem, 2vw, 3rem);">
    <i class="fa-brands fa-youtube" style="color: red;"></i> 유튜브
</h2>
<div id="youtubes" class="row me-1 ms-1" style="height: 100%;"></div>
<!-- handlebars -->
<script id="youtube-card" type="text/x-handlebars-template">
    {{#each items}}
    <div class="col-md-4 mb-4"> <!-- mb-4 추가하여 카드 간격 조정 -->
        <div class="story-card border rounded text-center" style="height: 100%"> <!-- border와 rounded 클래스를 사용 -->
            <a href="https://www.youtube.com/watch?v={{id.videoId}}">
                <img id="zoom-img" src="{{snippet.thumbnails.medium.url}}" alt="image" class="img-fluid" style="width: 100%; object-fit: cover;" />
            </a>
            <div class="p-3"> <!-- 패딩 추가 -->
                <p style="font-size: clamp(0.8rem, 1vw, 2rem);">{{snippet.title}}</p>
                <p style="font-size: clamp(0.8rem, 1vw, 2rem);"">{{snippet.description}}</p>
                <a href="https://www.youtube.com/channel/{{snippet.channelId}}">
                    <button class="btn btn-success">유튜브채널Link</button> <!-- btn-primary 클래스를 사용 -->
                </a>
            </div>
        </div>
    </div>
    {{/each}}
</script>

<!-- youtube api function -->
<script>
    // api key
    const API_KEY = 'AIzaSyAZ7HoGxJxn9fTmgHLhhsJSy7srAxmTN6Y'

    const getVideos = () => {
        // api url 호출
        $.ajax({
            method: 'GET',
            url: 'https://youtube.googleapis.com/youtube/v3/search',
            data: {
                key: API_KEY,       part: 'snippet',
                maxResults: 3,      q: '제로웨이스트',
                regionCode: 'kr',   order: 'viewCount',
                type: 'video',      videoDuration: 'medium'
            },
            dataType: 'json',
            success: (response) => {
                const youtubeData = {items : response.items}
                // youtubes handlebars 적용
                let temp = Handlebars.compile($("#youtube-card").html())
                $("#youtubes").html(temp(youtubeData))
            },
            error: (error) => {
                console.log(error);
            }
        })
    }
    getVideos()
</script>

<style>
    #zoom-img { transition: transform 0.5s ease; /* 부드러운 확대 효과 */ }
    #zoom-img:hover { transform: scale(1.02); /* 커서 오버 시 10% 확대 */ }
</style>
<!-------------------------- 유튜브 -------------------------------->


<!-------------------------- 쿼리스트링 alert 표시 -------------------------------->
<script>
    // 페이지가 로드될 때 쿼리 문자열을 확인
    window.onload = () => {
        const urlParams = new URLSearchParams(window.location.search);
        const message = urlParams.get('message'); // 'message' 쿼리 파라미터 가져오기
        if (message) {
            alert(message); // 메시지가 있으면 alert로 표시
        }
    }
</script>
<!-------------------------- 쿼리스트링 alert 표시 -------------------------------->