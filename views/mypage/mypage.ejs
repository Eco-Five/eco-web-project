<link rel="stylesheet" href="/styles/mypage/mypage.css">

<div class="profile-container">
    <div class="profile-header">
        <div class="profile-pic">
            <img src="profile-pic-placeholder.png" alt="Profile Picture">
        </div>
        <div class="profile-info">
            <h4>김에코님</h4>
            <p>3,500 point</p>
        </div>
    </div>

    <div class="progress-section">
        <div class="progress-circle">
            <p>프리미엄</p>
        </div>
    </div>

    <div class="my-eco-bag">
        <h4>나의 에코백</h4>
        <div class="eco-item">
            <div class="item-info">
                <p>친환경 스테인리스 텀블러</p>
                <p>25,000원</p>
            </div>
            <div class="item-actions">
                <button>리뷰</button>
                <button>링크</button>
            </div>
        </div>
    </div>

    <div class="my-eco-history">
        <h4>나의 활동 내역</h4>
        <div class="history-item">
            <p>친환경 제품 리뷰</p>
            <p>2023-04-10</p>
        </div>
    </div>

    <div class="settings">
        <button>개인정보 수정</button>
    </div>
</div>