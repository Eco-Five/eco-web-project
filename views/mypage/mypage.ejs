<link rel="stylesheet" href="/styles/mypage/mypage.css">

<div class="profile-container">
    <div class="profile-header">
        <div class="profile-pic">
            <h6 style="margin-top: 20px; justify-self: start;"><b>프로필</b></h6>
            <br />
            <img src="" alt="프로필사진">
            <input class="form-control" type="file" id="fileUpload" accept=".png, .jpg, .gif">
            <small class="text-muted">PNG, JPG, GIF 최대 10MB</small>
        </div>
    </div>
    <div class="custom-card text-center">
        <div class="tab-content">
            <div class="tab-pane fade show active" role="tabpanel" style="margin-top: 20px;">
                <h6 style="margin-top: 20px; justify-self: start;"><b>개인정보</b></h6>
                <br />
                    <div class="mb-3 d-flex align-items-center">
                        <label for="name" class="d-flex me-3 mb-2" style="flex-shrink: 0; width: 10%; ">이름</label>
                        <input type="text" id="name" style="width: 60%;" required>
                    </div>
                    <div class="mb-3 d-flex align-items-center">
                        <label for="email" class="d-flex me-3 mb-2" style="flex-shrink: 0; width: 10%;">이메일</label>
                        <input type="text" id="email" style="width: 60%;" required>
                    </div>
                    <div class="mb-3 d-flex align-items-center">
                        <label for="phone" class="d-flex me-3 mb-2" style="flex-shrink: 0; width: 10%;">전화번호</label>
                        <input type="text" id="phone" style="width: 60%;" required>
                    </div>
                    <div class="mb-3 d-flex align-items-center">
                        <label for="local" class="d-flex me-3 mb-2" style="flex-shrink: 0; width: 10%;">주소</label>
                        <input type="text" id="local" style="width: 60%;" required>
                    </div>
                    <div class="mb-3 d-flex">
                        <button class="btn btn-dark" id="updBtn" style="margin-left: auto; margin-right: 10px;">개인정보 수정</button>
                        <button class="btn btn-dark" id="delBtn" style="margin-right: 210px;">회원탈퇴</button>
                    </div>
                    
            </div>
        </div>
    </div>
<br/>
    <div class="hist-card">
        <div class="hist-info">
            <h6 style="margin-top: 20px;"><b>나의 활동 내역</b></h6>
            <div class="hist-item">
                <p id="date"></p>
                <a id="titleRef" href="#" style="color: #666;"><p id="title"></p></a>
                <p id="content"></p>
            </div>
        </div>
    </div>
<br/>
    <div class="ecobag-card">
        <div class="ecobag-info">
            <h6 style="margin-top: 20px;"><b>나의 에코백</b></h6>
            <div class="eco-item">
                <div class="item-info">
                    <p>친환경 스테인리스 텀블러</p>
                    <p>25,000원</p>
                </div>
            </div>
        </div>
    </div>
</div>
<%-include('./mypageConnDB.ejs') %>