<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>공지사항</h1>
        <a href="/notice/write" class="btn btn-primary">글쓰기</a>
    </div>
    <table class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th class="text-center" style="width: 5%;">번호</th>
                <th class="text-center" style="width: 10%;">카테고리</th>
                <th class="text-center" style="width: 50%;">제목</th>
                <th class="text-center" style="width: 20%;">작성일</th>
                <th class="text-center" style="width: 15%;">작성자</th>
            </tr>
        </thead>
        <tbody>
            <% if (notices.length > 0) { %>
                <% notices.forEach((notice) => { %>
                    <tr>
                        <td class="text-center"><%= notice.id %></td>
                        <td class="text-center"><span class="badge bg-info"><%= notice.category || "없음" %></span></td>
                        <td><a href="/notice/<%= notice.id %>" class="text-decoration-none"><%= notice.title %></a></td>
                        <td class="text-center"><%= new Date(notice.notice_date).toLocaleDateString("ko-KR") %></td>
                        <td class="text-center"><%= notice.member_name || "익명" %></td>
                    </tr>
                <% }); %>
            <% } else { %>
                <tr>
                    <td colspan="5" class="text-center">공지사항이 없습니다.</td>
                </tr>
            <% } %>
        </tbody>
    </table>

    <nav>
        <ul class="pagination justify-content-center">
            <% for (let i = 1; i <= totalPages; i++) { %>
                <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                    <a class="page-link" href="/api/notice?page=<%= i %>"><%= i %></a>
                </li>
            <% } %>
        </ul>
    </nav>