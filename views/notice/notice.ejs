    <div class="container mt-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>공지사항</h1>
            <a href="/notice/write" class="btn btn-primary">Write a new notice</a>
        </div>

        <form class="mb-4">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="검색어를 입력하세요" name="search">
                <button class="btn btn-dark" type="submit">검색</button>
            </div>
        </form>

        <table class="table table-bordered">
            <thead class="table-light">
                <tr>
                    <th>번호</th>
                    <th>카테고리</th>
                    <th>제목</th>
                    <th>작성일</th>
                    <th>조회수</th>
                </tr>
            </thead>
            <tbody>
                <% notices.forEach((notice) => { %>
                <tr>
                    <td><%= notice.number %></td>
                    <td><span class="badge bg-info"><%= notice.category %></span></td>
                    <td><a href="/notice/<%= notice.id %>" class="text-decoration-none"><%= notice.title %></a></td>
                    <td><%= notice.date %></td>
                    <td><%= notice.views %></td>
                </tr>
                <% }) %>
            </tbody>
        </table>

        <nav>
            <ul class="pagination justify-content-center">
                <li class="page-item">
                    <a class="page-link" href="#">&laquo;</a>
                </li>
                <li class="page-item"><a class="page-link" href="#">1</a></li>
                <li class="page-item"><a class="page-link" href="#">2</a></li>
                <li class="page-item"><a class="page-link" href="#">3</a></li>
                <li class="page-item">
                    <a class="page-link" href="#">&raquo;</a>
                </li>
            </ul>
        </nav>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>