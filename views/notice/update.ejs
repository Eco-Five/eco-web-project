<div class="container mt-5">
  <h1 class="mb-4">Edit Notice</h1>
  <form method="POST" action="/notice/<%= notice.id %>?_method=PUT">
      <div class="mb-3">
          <label for="category" class="form-label">Category</label>
          <select id="category" name="category" class="form-select" required>
              <option value="general" <%= notice.category === 'general' ? 'selected' : '' %>>General</option>
              <option value="event" <%= notice.category === 'event' ? 'selected' : '' %>>Event</option>
              <option value="system" <%= notice.category === 'system' ? 'selected' : '' %>>System</option>
          </select>
      </div>

      <div class="mb-3">
          <label for="title" class="form-label">Title</label>
          <input type="text" id="title" name="title" class="form-control" value="<%= notice.title %>" required>
      </div>

      <div class="mb-3">
          <label for="content" class="form-label">Content</label>
          <textarea id="content" name="content" class="form-control" rows="5" required><%= notice.content %></textarea>
      </div>

      <button type="submit" class="btn btn-success">Update</button>
  </form>
</div>