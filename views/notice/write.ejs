<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Write Notice</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-5">
        <h1 class="mb-4">공지사항등록</h1>
        <form>
            <div class="mb-3">
                <label for="category" class="form-label">Category</label>
                <select id="category" name="category" class="form-select">
                    <option value="update">업데이트</option>
                    <option value="service">서비스공지</option>
                </select>
            </div>

            <div class="mb-3">
                <label for="title" class="form-label">제목</label>
                <input type="text" id="title" name="title" class="form-control" required>
            </div>

            <div class="mb-3">
                <label for="content" class="form-label">내용</label>
                <textarea id="content" name="content" class="form-control" rows="5" required></textarea>
            </div>

            <button type="submit" class="btn btn-primary">작성완료</button>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(() => {
            // Form submission via AJAX
            $("form").on("submit", (event) => {
                event.preventDefault(); // Prevent the default form submission

                const payload = {
                    category: $("#category").val(), // Get the selected category
                    title: $("#title").val(),       // Get the title
                    content: $("#content").val()    // Get the content
                };

                // Send AJAX request to the server
                $.ajax({
                    url: "/api/notice/write", // API endpoint for creating a notice
                    type: "POST",
                    contentType: "application/json", // Send data as JSON
                    data: JSON.stringify(payload),   // Convert payload to JSON string
                    beforeSend: function () {
                        $("button[type='submit']").prop("disabled", true); // Disable the submit button
                    },
                    success: function (response) {
                        if (response.success) {
                            alert("Notice has been successfully created.");
                            location.href = "/notice"; // Redirect to the notices list page
                        } else {
                            alert("Failed to create the notice. Please try again.");
                        }
                    },
                    error: function (xhr, status, error) {
                        alert("An error occurred: " + error);
                    },
                    complete: function () {
                        $("button[type='submit']").prop("disabled", false); // Re-enable the submit button
                    }
                });
            });
        });
    </script>
</body>
</html>
