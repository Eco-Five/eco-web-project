<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Write Notice</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-5">
        <h1 class="mb-4">공지사항등록</h1>
        <form>
            <div class="mb-3">
                <label for="category" class="form-label">Category</label>
                <select id="category" name="category" class="form-select">
                    <option value="업데이트">업데이트</option>
                    <option value="서비스공지">서비스공지</option>
                </select>
            </div>

            <div class="mb-3">
                <label for="title" class="form-label">제목</label>
                <input type="text" id="title" name="title" class="form-control" required>
            </div>

            <div class="mb-3">
                <label for="writer" class="form-label">작성자</label>
                <input type="text" id="member_id" name="member_id" class="form-control" required>
            </div>

            <div class="mb-3">
                <label for="content" class="form-label">내용</label>
                <textarea id="content" name="content" class="form-control" rows="5" required></textarea>
            </div>

            <button type="submit" class="btn btn-primary">작성</button>
            <a href="/notice" class="btn btn-secondary" id="btn-list">목록</a>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(() => {
            // Form submission via AJAX
            $("form").on("submit", (event) => {
                event.preventDefault(); // Prevent the default form submission

                const categoryMapping = {
                    "업데이트": "업데이트",
                    "서비스공지": "서비스공지"
                };

                const selectedCategory = $("#category").val();
                const mappedCategory = categoryMapping[selectedCategory];

                if (!mappedCategory) {
                    alert("Invalid category selected.");
                    return; // Stop further processing
                }

                const payload = {
                    category: mappedCategory, // Use the mapped category
                    title: $("#title").val(),
                    content: $("#content").val(),
                    member_id: $("#member_id").val() // Include the writer's name
                };

                console.log("Payload being sent:", payload);

                // Send AJAX request to the server
                $.ajax({
                    url: "/api/notice/write", // API endpoint for creating a notice
                    type: "POST",
                    contentType: "application/json", // Send data as JSON
                    data: JSON.stringify(payload),   // Convert payload to JSON string
                    beforeSend: function () {
                        $("button[type='submit']").prop("disabled", true); // Disable the submit button
                    },
                    success: function (response) {
                        if (response.success) {
                            alert("작성 완료되었습니다.");
                            location.href = "/notice"; // Redirect to the notices list page
                        } else {
                            alert("글작성 실패하였습니다. 다시 시도해주세요.");
                        }
                    },
                    error: function (xhr, status, error) {
                        alert("An error occurred: " + error);
                    },
                    complete: function () {
                        $("button[type='submit']").prop("disabled", false); // Re-enable the submit button
                    }
                });
            });
        });
    </script>
</body>
</html>
