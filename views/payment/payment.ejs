<div class="container my-5" style="max-width: 800px;">
    <!-- Header -->
    <h2 class="text-center mb-2 fw-bold">친환경 멤버십 구독</h2>
    <p class="text-center mb-5 text-muted">지속 가능한 미래를 위한 합리적 선택</p>

    <!-- Pricing Plans -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card h-100" style="box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);">
                <div class="card-body">
                    <h5 class="card-title fw-bold">기본형</h5>
                    <span class="card-text fs-4">₩10</span><span>/월</span>
                    <ul class="list-unstyled">
                        <li>✔️ 기본 리포트 제공</li>
                        <li>✔️ 환경 인식자료 제공</li>
                        <li>✔️ 멤버십 보너스 포함</li>
                    </ul>
                    <button class="btn btn-dark select-plan">선택하기</button>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100" style="box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);">
                <div class="card-body">
                    <h5 class="card-title fw-bold">프리미엄</h5>
                    <span class="card-text fs-4">₩20</span><span>/월</span>
                    <ul class="list-unstyled">
                        <li>✔️ 모든 멤버십 혜택 제공</li>
                        <li>✔️ 각종 리포트 무료제공</li>
                        <li>✔️ 고객지원 우선 처리</li>
                    </ul>
                    <button class="btn btn-dark select-plan">선택하기</button>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100" style="box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);">
                <div class="card-body">
                    <h5 class="card-title fw-bold">기업형</h5>
                    <span class="card-text fs-4">₩30</span><span>/월</span>
                    <ul class="list-unstyled">
                        <li>✔️ 기업용 환경 분석 제공</li>
                        <li>✔️ ESG 관련 추가 자료</li>
                        <li>✔️ 컨설팅 서비스 포함</li>
                    </ul>
                    <button class="btn btn-dark select-plan">선택하기</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Payment Info -->
    <div class="p-4 rounded border" style="box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);">
        <h4 class="mb-4">결제 정보</h4>

        <form class="p-3 mb-3 bg-light">
            <p class="fw-bold">선택한 구독상품</p>
            <div class="d-flex justify-content-between">
                <span id="selected-plan">선택없음</span>
                <div>
                    <span id="selected-price" class="fw-bold fs-5">₩0</span><span
                        style="font-size: clamp(0.6rem, 1.0vw, 0.9rem);">/월</span>
                </div>
            </div>
        </form>

        <form>
            <input type="button" id="naverPayBtn" class="btn btn-success w-100" value="네이버페이 결제">
            <div class="mb-3 mt-3">
                <label for="card-number" class="form-label">카드 번호</label>
                <input type="text" class="form-control" id="card-number" placeholder="0000 0000 0000 0000">
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="expiry-date" class="form-label">유효기간</label>
                    <input type="text" class="form-control" id="expiry-date" placeholder="MM/YY">
                </div>
                <div class="col-md-6 mb-3">
                    <label for="cvc" class="form-label">CVC</label>
                    <input type="text" class="form-control" id="cvc" placeholder="123">
                </div>
            </div>
            <div class="mb-3">
                <label for="card-holder" class="form-label">카드 소유자</label>
                <input type="text" class="form-control" id="card-holder" placeholder="이름 입력">
            </div>
            <input type="button" class="btn btn-dark w-100" value="카드 결제">
        </form>
    </div>
</div>


<!-- Bootstrap JS -->
<script src="https://nsp.pay.naver.com/sdk/js/naverpay.min.js"></script>
<script>
    let subsPlan = ''
    let subsPrice = 0

    // Plan Selection Logic
    $('.card').each(function () {
        $(this).on('click', () => {
            $('.card').removeClass('border-dark');
            $(this).addClass('border-dark');
            $('#selected-plan').html($(this).find('.card-title').text());
            $('#selected-price').html($(this).find('.card-text').text());
            subsPlan = $('#selected-plan').text()
            subsPrice = $('#selected-price').text().slice(1, 3)
        });
    });


    // NaverPay
    const oPay = Naver.Pay.create({
        "mode": "development", // development or production
        "clientId": "<%= clientId %>",
        "chainId": "<%= chainId %>",
    });


    //직접 만드신 네이버페이 결제버튼에 click Event를 할당하세요
    const elNaverPayBtn = document.getElementById("naverPayBtn");
    elNaverPayBtn.addEventListener("click", function () {
        oPay.open({
            "merchantPayKey": "202412270n1edr",
            "productName": subsPlan,
            "productCount": "1",
            "totalPayAmount": subsPrice,
            "taxScopeAmount": subsPrice,
            "taxExScopeAmount": "0",
            "returnUrl": `http://<%= localhostIP %>:5678/users/payment/resultPay?subsPlan=${subsPlan}&subsPrice=${subsPrice}`
        });
    });
</script>