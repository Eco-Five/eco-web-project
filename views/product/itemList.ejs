<link rel="stylesheet" href="/styles/product/product.css">

<div class="row mt-5 justify-content-center">
    <div class="col-6 col-md-4">
        <div class="search-pic">
        </div>
        <div class="input-group">
            <input type="text" id="query" class="form-control" placeholder="제품 검색" />
            <img id="searchImg" src="../images/product/ser.png" alt="검색아이콘">
            <img id="recImg" src="../images/product/rec.png" alt="기록아이콘">
        </div>
    </div>
</div>
<hr />

<div class="row mt-3 justify-content-center">
    <div class="col-6 col-md-4 d-flex justify-content-end">
        <select id="sort" class="form-select" style="width: 150px;">
            <option value="sim">정확도순</option>
            <option value="asc">낮은가격순</option>
            <option value="dsc">높은가격순</option>
        </select>
    </div>
</div>

<div class="container my-4">
    <div class="row" id="card-container"></div>
</div>

<script id="card-template" type="text/x-handlebars-template">
    <div class="container py-5">
        <h5 class="text mb-4 fw-bold">친환경 제품</h5>
        <div class="row g-4">
        {{#each list}}
        <div class="col-md-3" style="border: 1px solid #e0e0e0; border-radius: 10px;">
            <div class="category-card">
                <img src="{{image}}" index="{{@index}}" class="img-fluid" style="cursor: pointer;width:40%">
                <div class="ellipsis mt-2">{{clean title}}</div>
                <br />
                    <b>{{format lprice}}</b>
                        <button index="{{@index}}" class="btn btn-dark btn-sm" style="min-width: 10px; font-size: 0.7vw">에코백담기</button>
                    <a href="{{link}}">
                        <button class="btn btn-dark btn-sm" style="min-width: 10px; font-size: 0.7vw">네이버쇼핑</button>
                    </a>
                </div>
                <%-include("itemModal.ejs") %>
            </div>
        {{/each}}
        </div>
    </div>
</script>

<div class="text-center mt-2">
    <button class="btn btn-dark btn-sm px-5" id="prev">이전</button>
    <span id="page" class="px-3">1/9</span>
    <button class="btn btn-dark btn-sm px-5" id="next">다음</button>
</div>

<script>
    let currentPage = 1;
    const itemsPerPage = 8;
    let totalPages = 0;  
    let allItems = [];
    const querySelect = document.getElementById('query');
    const sortSelect = document.getElementById('sort');

    // 페이지 로드 시 기본 쿼리값
    document.addEventListener('DOMContentLoaded', () => {
        const defaultQuery = "친환경";  
        const sort = sortSelect.value;
        productList(defaultQuery, currentPage, sort);  
    });

    // 네이버API 호출 함수
    async function productList(query, page = 1, sort) {
        const response = await fetch(`/api/naverShop`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ values: query, page: page, sort: sort })  
        });
        const data = await response.json();
        
        allItems = data.list;
        totalPages = data.totalPages;

        // 페이징 처리
        const startIndex = (page - 1) * itemsPerPage;
        const paginatedItems = allItems.slice(startIndex, startIndex + itemsPerPage);

        // Handlebars에 객체 할당
        let temp = Handlebars.compile($("#card-template").html());
        $("#card-container").html(temp({ list: paginatedItems }));  

        // 페이지 표시 업데이트
        document.getElementById('page').textContent = `${data.currentPage}/${totalPages}`;

        // 이전, 다음 버튼 업데이트
        document.getElementById('prev').disabled = data.currentPage === 1;
        document.getElementById('next').disabled = data.currentPage === totalPages;
    }

    // 검색 버튼 클릭 시
    const imgSearch = document.getElementById('searchImg');
    imgSearch.addEventListener('click', async () => {
        currentPage = 1; 
        const query = document.getElementById('query').value;
        const sort = sortSelect.value;
        productList(query, currentPage, sort); 
    });

    // 검색창 Enter 시 동작
    querySelect.addEventListener('keydown', async (event) => {
        if (event.keyCode === 13) {  
            currentPage = 1; 
            const query = querySelect.value;
            const sort = sortSelect.value;
            productList(query, currentPage, sort);
        }
    });

    // 이전 페이지 버튼 클릭 시
    document.getElementById('prev').addEventListener('click', () => {
        if (currentPage > 1) {
            currentPage--;
            const query = querySelect.value;
            const sort = sortSelect.value;
            productList(query, currentPage, sort); 
        }
    });

    // 다음 페이지 버튼 클릭 시
    document.getElementById('next').addEventListener('click', () => {
        if (currentPage < totalPages) {
            currentPage++;
            const query = querySelect.value;
            const sort = sortSelect.value;
            productList(query, currentPage, sort); 
        }
    });

    // 콤보박스 변경 시
    sortSelect.addEventListener('change', () => {
        const query = querySelect.value;
        const sort = sortSelect.value;
        currentPage = 1;  
        productList(query, currentPage, sort); 
    });

</script>

<script>
    // 가격 포맷형식
    Handlebars.registerHelper("format", function (price) {
        return price.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',') + '원';
    });

    // HTML 태그제거
    Handlebars.registerHelper("clean", function (title) {
        const cleanedTitle = title.replace(/<[^>]+>/g, '');
        return cleanedTitle;
    });
</script>

<script>
    // 모달 호출
    $("#card-container").on("click", ".category-card img", function () {
        let index = $(this).attr("index")
        console.log(index)
        $(`#modal${index}`).modal("show")
    })
</script>

<script>
    // 상품 이미지 클릭 시 최근 본 상품에 추가
    $("#card-container").on("click", ".category-card img", function () {
        let image = $(this).attr("src");
        let link = $(this).parent().find("a").attr("href");

        // 서버에 최근 본 상품 정보 전송
        fetch('/recentViewed', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ image, link })
        }).then(response => response.json())
            .then(data => {
                console.log(data.message);
            })
            .catch(error => console.error('Error:', error));
    });

    // 최근 본 상품 불러오기
    const recImg = document.getElementById("recImg");
    let isRendered = false; 
    recImg.addEventListener('click', () => {
        const recentContainer = document.getElementById('recent-viewed-container');

        if (isRendered) {
            recentContainer.innerHTML = '';  
            isRendered = false; 
        } else {
            fetch('/recentViewed')
                .then(response => response.json())
                .then(data => {
                    const recentViewed = data.recentViewed;
                    if (recentViewed && recentViewed.length > 0) {
                        // 최근 본 상품 렌더링
                        let recentHtml = '<h6><b>최근 본 상품</b></h6><div>';
                        recentViewed.forEach(item => {
                            recentHtml += `
                                <div>
                                    <div class="category-card">
                                        <a href="${item.link}">
                                            <img src="${item.image}" class="img-fluid">
                                        </a>
                                    </div>
                                </div>
                            `;
                        });
                        recentHtml += '</div>';
                        recentContainer.innerHTML = recentHtml;
                        isRendered = true;  
                    }
                })
                .catch(error => console.error('Error:', error));
        }
    });
</script>

<!-- 최근 본 상품 영역 추가 -->
<div id="recent-viewed-container" class="container my-4"></div>