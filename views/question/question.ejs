<link rel="stylesheet" href="/styles/question/question.css">
<div class="container mt-5">
    <div class="d-flex justify-content-start align-items-center mb-4">
        <h3>고객문의</h3>
    </div>
    <div class="mb-3 d-flex justify-content-between">
        <select class="form-select w-auto" id="category-select">
            <option value="all" <% if(category === 'all'){ %> selected <% } %>>전체</option>
            <option value="4" <% if(category === '4'){ %> selected <% } %>>배송</option>
            <option value="5" <% if(category === '5'){ %> selected <% } %>>상품</option>
            <option value="6" <% if(category === '6'){ %> selected <% } %>>교환/반품</option>
        </select>
        <button class="btn btn-dark" id="btn-write">문의하기</button>
    </div>
    <div class="table-responsive" id="question-table">
        <!-- 질문 목록 -->
    </div>
    <!-- 페이징 처리 -->
    <nav class="mt-4" id="pagination">
        <!-- 페이지네이션 -->
    </nav>
</div>

<script>
    console.log("Logged-in User:", "<%= user ? user.member_id : 'No User' %>");
    // 로그인/비로그인 상태에 따른 글쓰기 버튼 처리
    document.querySelector("#btn-write")?.addEventListener("click", () => {
    const loggedInUser = "<%= user ? user.member_id : 'No User' %>";
    if (loggedInUser === 'No User') {
        alert('로그인이 필요합니다.');
    } else {
        location.href = '/question/write';
    }
});

    // 카테고리 변경 시 데이터를 다시 로드
    document.getElementById('category-select').addEventListener('change', (event) => {
        const selectedCategory = event.target.value;
        loadQuestions(selectedCategory, 1);  // 페이지 1부터 시작
    });

    // 페이지네이션 버튼 클릭 시
    function changePage(page) {
        const selectedCategory = document.getElementById('category-select').value;
        loadQuestions(selectedCategory, page);
    }

    // 질문 목록과 페이징 처리 함수
    async function loadQuestions(category, page) {
        try {
            const res = await fetch(`/api/question?page=${page}&category=${category}`);
            const data = await res.json();
            renderQuestions(data.questions);
            renderPagination(data.totalPages, data.currentPage, category);
        } catch (error) {
            console.error('질문 목록을 불러오는 데 실패했습니다.', error);
        }
    }

    // 질문 목록을 렌더링하는 함수
    function renderQuestions(questions) {
        if (!questions) {
        console.error("질문 목록이 없습니다.");
        return; // 또는 에러 메시지 표시
    }
        const table = document.getElementById('question-table');
        table.innerHTML = `
            <table class="table table-bordered">
                <thead class="table-light">
                    <tr>
                        <th scope="col">번호</th>
                        <th scope="col">문의유형</th>
                        <th scope="col">제목</th>
                        <th scope="col">작성자</th>
                        <th scope="col">작성일</th>
                        <th scope="col">상태</th>
                    </tr>
                </thead>
                <tbody>
                    ${questions.map(question => `
                        <tr>
                            <td>${question.inquiry_id}</td>
                            <td>${question.type_name}</td>
                            <td><a href="/question/${question.inquiry_id}">${question.title}</a></td>
                            <td>${question.name}</td>
                            <td>${formatDate(question.inquiry_date)}</td>
                            <td>
                                ${question.status === '답변대기' ? 
                                    `<span class="badge bg-warning">${question.status}</span>` : 
                                    `<span class="badge bg-success">${question.status}</span>`}
                            </td>
                        </tr>
                    `).join('')}
                </tbody>
            </table>
        `;
    }

    // 페이징 처리 렌더링 함수
    const renderPagination = (totalPages, currentPage, category) => {
        const pagination = document.getElementById('pagination');
        let paginationHtml = '<ul class="pagination justify-content-center">';

        // 이전 페이지
        paginationHtml += currentPage > 1 ? 
            `<li class="page-item"><a class="page-link" href="javascript:void(0);" onclick="changePage(${currentPage - 1})">&lt;</a></li>` : 
            `<li class="page-item disabled"><a class="page-link" href="#"> &lt; </a></li>`;

        // 페이지 번호
        for (let i = 1; i <= totalPages; i++) {
            paginationHtml += `<li class="page-item ${currentPage === i ? 'active' : ''}">
                <a class="page-link" href="javascript:void(0);" onclick="changePage(${i})">${i}</a>
            </li>`;
        }

        // 다음 페이지
        paginationHtml += currentPage < totalPages ? 
            `<li class="page-item"><a class="page-link" href="javascript:void(0);" onclick="changePage(${currentPage + 1})">&gt;</a></li>` : 
            `<li class="page-item disabled"><a class="page-link" href="#"> &gt; </a></li>`;

        paginationHtml += '</ul>';
        pagination.innerHTML = paginationHtml;
    };

    // 날짜 포맷팅 함수
    const formatDate = (dateStr) => {
        const date = new Date(dateStr);
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');
        const hours = String(date.getHours()).padStart(2, '0');
        const minutes = String(date.getMinutes()).padStart(2, '0');
        return `${year}.${month}.${day} ${hours}:${minutes}`;
    };

    // 페이지 로드 시 기본 데이터 로드
    window.onload = () => {
        const category = document.getElementById('category-select').value;
        loadQuestions(category, 1);  // 기본 페이지는 1
    };
</script>