<div class="container mt-5">
    <!-- 게시글 상세 -->
    <div class="card p-4 mb-4">
        <h1 class="h4"><%=question.title%></h1>
        <small class="text-muted"><%=question.name %> · <%= formatDate(question.inquiry_date)%> · <i class="bi bi-eye"></i> 1,234</small>
        <p class="mt-3">
            <%=question.content%>
        </p>
        <div class="d-flex justify-content-between align-items-center mt-4">
            <span class="text-muted"></span>
            <div>
                <button class="btn btn-outline-primary btn-sm me-2" id="btn-update"><i class="bi bi-pencil"></i> 수정</button>
                <button class="btn btn-outline-danger btn-sm me-2" id="btn-delete"><i class="bi bi-trash"></i> 삭제</button>
                <button class="btn btn-outline-primary btn-sm me-2" id="btn-list"><i class="bi bi-list"></i> 목록</button>
            </div>
        </div>
    </div>

    <!-- 댓글 섹션 -->
    <div>
        <h5>답변</h5>
        <!-- 댓글 작성 섹션 -->
        <div class="mb-3">
            <textarea class="form-control" rows="3" placeholder="관리자만 댓글을 작성할 수 있습니다."></textarea>
            <div class="text-end mt-2">
                <button class="btn btn-dark">댓글 작성</button>
            </div>
        </div>
        <!-- 댓글 리스트 -->
        <div class="mt-4">
            <div class="mb-3">
                <strong>관리자</strong> <small class="text-muted"><%= formatDate(question.comment_date)%></small>
                <p><%=question.comment%></p>
            </div>
        </div>
    </div>
</div>

<script>
//목록으로 돌아가기
$("#btn-list").on("click", function(){
    location.href="/question"
})
