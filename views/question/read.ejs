<div class="container mt-5">
    <!-- 게시글 상세 -->
    <div class="card p-4 mb-4">
        <h1 class="h4" id="question-title"></h1>
        <small class="text-muted" id="question-author"></small>
        <small class="text-muted" id="question-date"></small>
        <p class="mt-3" style="white-space: pre-line;" id="question-content"></p>
        <div class="d-flex justify-content-between align-items-center mt-4">
            <span class="text-muted"></span>
            <div>
                <!-- 수정/삭제 버튼은 클라이언트에서 동적으로 처리 -->
                <button class="btn btn-outline-primary btn-sm me-2" id="btn-update"><i class="bi bi-pencil"></i> 수정</button>
                <button class="btn btn-outline-danger btn-sm me-2" id="btn-delete"><i class="bi bi-trash"></i> 삭제</button>
                <button class="btn btn-outline-primary btn-sm me-2" id="btn-list"><i class="bi bi-list"></i> 목록</button>
            </div>
        </div>
    </div>

    <!-- 댓글 섹션 -->
    <div>
        <h5>답변</h5>
        <!-- 댓글 작성 섹션 -->
        <% if (user && user.name === "김지영") { %>
            <textarea class="form-control" rows="3" id="comment" placeholder="답변을 등록하세요."></textarea>
            <div class="text-end mt-2">
                <button class="btn btn-dark" id="btn-comment">댓글 작성</button>
            </div>
            <% } else{ %>
            <textarea class="form-control" rows="3" id="comment" placeholder="관리자만 답변을 작성할 수 있습니다." readonly></textarea>
            <% } %>
        </div>

        <!-- 댓글 리스트 -->
        <div class="mt-4" id="comment-section">
            <!-- 댓글 내용은 JavaScript에서 처리 -->
        </div>
    </div>
</div>

<script>
console.log("Logged-in User:", "<%= user ? user.member_id : 'No User' %>");
document.addEventListener("DOMContentLoaded", async () => {
    const q_no = "<%= q_no %>"; // 전달된 q_no 사용
    const loggedInUser = "<%= user ? user.member_id : '' %>" // 로그인한 사용자 member_id

    // API 호출하여 question 데이터 가져오기
    try {
        const response = await fetch(`/api/question/${q_no}`);
        const result = await response.json();

        if (result.success) {
            const question = result.question; // API에서 받은 question 데이터를 사용

            // question 데이터로 페이지 내용 업데이트
            document.getElementById('question-title').textContent = question.title;
            document.getElementById('question-author').textContent = `${question.name} · ${formatDate(question.inquiry_date)}`;
            document.getElementById('question-content').textContent = question.content;

            // 작성자와 로그인한 사용자가 다르면 수정/삭제 버튼 숨김
            if (String(loggedInUser).trim() !== String(question.member_id).trim()) {
                        document.getElementById('btn-update').style.display = 'none';
                        document.getElementById('btn-delete').style.display = 'none';
                    }

            // 댓글 처리
            const commentSection = document.getElementById('comment-section');
            if (question.comment && question.comment_date) {
                // 댓글 존재시 해당 댓글을 표시
                const commentHTML = `
                    <div class="mb-3" id="comment-${question.inquiry_comment_id}">
                        <strong>관리자</strong> <small class="text-muted">${formatDate(question.comment_date)}</small> 
                        <button class="btn btn-outline-secondary btn-sm me-2" 
                                id="btn-comment-delete-${question.inquiry_comment_id}" 
                                style="margin-left: 10px;">
                            <i class="bi bi-trash"></i>
                        </button>
                        <p style="padding-right: 50px;white-space: pre-line;">${question.comment}</p>
                    </div>
                `;
                commentSection.innerHTML = commentHTML;

                // 댓글 삭제 버튼 이벤트 추가
                document.querySelector(`#btn-comment-delete-${question.inquiry_comment_id}`).addEventListener('click', async () => {
                    try {
                        const deleteResponse = await fetch(`/api/question/comment/${question.inquiry_comment_id}`, {
                            method: 'DELETE',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ q_no: q_no })
                        });

                        const deleteResult = await deleteResponse.json();
                        if (deleteResult.success) {
                            // 댓글 삭제 후 UI에서 해당 댓글 제거
                            const commentDiv = document.getElementById(`comment-${question.inquiry_comment_id}`);
                            commentDiv.remove();  // 댓글 div를 제거
                        } else {
                            alert("댓글 삭제 실패");
                        }
                    } catch (error) {
                        alert("오류 발생: " + error);
                    }
                });
            } else {
                commentSection.innerHTML = "<strong>답변 대기 중입니다.</strong>";
            }
        } else {
            alert("게시글을 가져오는데 실패했습니다.");
        }
    } catch (error) {
        alert("오류 발생: " + error);
    }
    

    // 목록으로 돌아가기
    document.querySelector("#btn-list").addEventListener("click", () => {
        location.href = "/question";
    });

    // 게시글 수정하기
    document.querySelector("#btn-update")?.addEventListener("click", () => {
        location.href = `/question/update/<%= q_no %>`;
    });

    // 게시글 삭제하기
    document.querySelector("#btn-delete")?.addEventListener("click", async () => {
        const q_no = "<%= q_no %>";
        
        try {
            const response = await fetch(`/api/question/${q_no}`, {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ q_no: q_no })
            });

            const data = await response.json();
            if (data.success) {
                alert("삭제 완료되었습니다");
                location.href = "/question";
            } else {
                alert("삭제 실패했습니다.");
            }
        } catch (error) {
            alert("오류 발생: " + error);
        }
    });

    // 댓글 작성
    document.querySelector("#btn-comment")?.addEventListener("click", async (event) => {
        event.preventDefault();

        const comment = document.querySelector("#comment").value;
        const q_no = "<%= q_no %>";
        
        try {
            const response = await fetch(`/api/question/${q_no}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ comment })
            });

            const data = await response.json();
            if (data.success) {
                alert("댓글이 등록되었습니다.");
                location.reload();  // 댓글 등록 후 새로고침
            } else {
                alert("댓글 등록 실패했습니다.");
            }
        } catch (error) {
            alert("오류 발생: " + error);
        }
    });
});
// 날짜 포맷팅 함수
const formatDate = (dateStr) => {
        const date = new Date(dateStr);
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');
        const hours = String(date.getHours()).padStart(2, '0');
        const minutes = String(date.getMinutes()).padStart(2, '0');
        return `${year}.${month}.${day} ${hours}:${minutes}`;
    };
</script>