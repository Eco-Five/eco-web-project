<link rel="stylesheet" href="/styles/question/question.css">
    <div class="container mt-5">
        <div class="card">
            <div class="card-header text-white bg-dark">
                <div class="align-items-center">
                    <h4 class="mb-0">고객문의</h4>
                    <p class="mb-0">친환경적인 미래를 위한 여러분의 소중한 의견을 기다립니다</p>
                </div>
            </div>
            <div class="card-body">
                <form>
                    <div class="mb-3">
                        <label for="category" class="form-label">문의 유형</label>
                        <select id="category" class="form-select">
                            <option value="<%= inquiry.content_type_id %>" selected><%= inquiry.type_name %></option>
                            <option value="4">배송</option>
                            <option value="5">상품</option>
                            <option value="6">교환/반품</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="title" class="form-label">제목</label>
                        <input type="text" class="form-control" id="title" placeholder="제목을 입력하세요" value="<%=inquiry.title%>">
                    </div>
                    <div class="mb-3">
                        <label for="content" class="form-label">내용</label>
                        <textarea class="form-control" id="content" rows="20" placeholder="내용을 입력하세요"><%=inquiry.content%></textarea>
                    </div>
                    <div class="d-flex justify-content-end">
                        <button type="button" class="btn btn-secondary me-2" id="btn-list">취소</button>
                        <button type="submit" class="btn btn-primary" id="btn-update">수정</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
    $(document).ready(() => {
        $("#btn-list").click(() => {
            location.href = "/question"; 
        })

        // 수정 버튼 클릭 시 폼 데이터를 서버로 전송
        $("#btn-update").click((event) => {
                event.preventDefault();  // 폼 제출을 막고 AJAX로 처리
    
                const q_no = "<%= inquiry.inquiry_id %>"  // 수정할 게시글의 ID
                const content_type_id = $("#category").val() // 카테고리
                const title = $("#title").val()  // 제목
                const content = $("#content").val()  // 내용
    
                // 서버로 AJAX 요청을 보내기
                $.ajax({
                    url: '/api/question/update',  // 서버의 수정 API 경로
                    type: 'PUT',
                    data: {
                        q_no: q_no,
                        content_type_id: content_type_id,
                        title: title,
                        content: content
                    },
                    success: function(response) {
                        if (response.success) {
                            alert("수정 완료되었습니다.");
                            location.href = "/question";  // 수정 성공 시 목록 페이지로 이동
                        } else {
                            alert("수정 실패했습니다.");
                        }
                    },
                    error: function(xhr, status, error) {
                        alert("오류 발생: " + error);
                    }
                });
            });
        });
    </script>