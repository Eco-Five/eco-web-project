<link rel="stylesheet" href="/styles/board/board.css">
    <div class="container mt-5">
        <div class="card">
            <div class="card-header text-white bg-dark">
                <div class="align-items-center">
                    <h4 class="mb-0">고객문의</h4>
                    <p class="mb-0">친환경적인 미래를 위한 여러분의 소중한 의견을 기다립니다</p>
                </div>
            </div>
            <div class="card-body">
                <form>
                    <div class="mb-3">
                        <label for="category" class="form-label">문의 유형</label>
                        <select id="category" class="form-select">
                            <option selected>문의 유형을 선택하세요</option>
                            <option value="1">배송</option>
                            <option value="2">상품</option>
                            <option value="3">교환/반품</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="title" class="form-label">제목</label>
                        <input type="text" class="form-control" id="title" placeholder="제목을 입력하세요">
                    </div>
                    <div class="mb-3">
                        <label for="content" class="form-label">내용</label>
                        <textarea class="form-control" id="content" rows="20" placeholder="내용을 입력하세요"></textarea>
                    </div>
                    <div class="d-flex justify-content-end">
                        <button type="button" class="btn btn-secondary me-2" id="btn-list">취소</button>
                        <button type="submit" class="btn btn-primary" id="btn-write">등록</button>
                    </div>
                </form>
            </div>
        </div>
    </div>






    <script>
    $(document).ready(() => {
        $("#btn-list").click(() => {
            location.href = "/question"; 
        })

        $("#btn-write").click(() => {
            alert("글 등록 성공"); 
            event.preventDefault();  // 버튼 타입 submit -> 폼 제출을 방지
            location.href = "/question";  
        })
    });

