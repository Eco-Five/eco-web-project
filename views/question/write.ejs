<link rel="stylesheet" href="/styles/question/question.css">
<div class="container mt-5">
    <div class="card">
        <div class="card-header text-white bg-dark">
            <div class="align-items-center">
                <h4 class="mb-0">고객문의</h4>
                <p class="mb-0">친환경적인 미래를 위한 여러분의 소중한 의견을 기다립니다</p>
            </div>
        </div>
        <div class="card-body">
            <form>
                <div class="mb-3">
                    <label for="category" class="form-label">문의 유형</label>
                    <select id="category" class="form-select">
                        <option selected>문의 유형을 선택하세요</option>
                        <option value="4">구독</option>
                        <option value="5">상품</option>
                        <option value="6">기타</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label for="title" class="form-label">작성자</label>
                    <input type="text" class="form-control" id="member_id" value="<%= user ? user.member_id : '' %>" hidden>
                    <input type="text" class="form-control" value="<%= user ? user.name : '' %>" readonly>
                </div>
                <div class="mb-3">
                    <label for="title" class="form-label">제목</label>
                    <input type="text" class="form-control" id="title" placeholder="제목을 입력하세요">
                </div>
                <div class="mb-3">
                    <label for="content" class="form-label">내용</label>
                    <textarea class="form-control" id="content" rows="20" placeholder="내용을 입력하세요"></textarea>
                </div>
                <div class="d-flex justify-content-end">
                    <button type="button" class="btn btn-secondary me-2" id="btn-list">취소</button>
                    <button type="submit" class="btn btn-primary" id="btn-write">등록</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", () => {
    // 취소 버튼 클릭 시 목록 페이지로 이동
    document.getElementById("btn-list").addEventListener("click", () => {
        location.href = "/question";
    });

    // 작성 버튼 클릭 시 데이터를 서버로 전송
    document.getElementById("btn-write").addEventListener("click", async (event) => {
        event.preventDefault();  // 폼 제출을 막고 fetch로 처리
        
        const member_id = document.getElementById("member_id").value; // 작성자 ID (숨겨진 값)
        const content_type_id = document.getElementById("category").value; // 카테고리
        const title = document.getElementById("title").value; // 제목
        const content = document.getElementById("content").value; // 내용

        const postData = {
            member_id: member_id,
            content_type_id: content_type_id,
            title: title,
            content: content
        };

        try {
            // 서버로 POST 요청 보내기
            const response = await fetch('/api/question/write', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json', // JSON 형식으로 전송
                },
                body: JSON.stringify(postData), // 데이터를 JSON 형식으로 변환하여 전송
            });

            const data = await response.json(); // 응답을 JSON으로 파싱

            if (data.success) {
                alert("등록 완료되었습니다.");
                window.location.href = "/question";  // 등록 성공 시 목록 페이지로 이동
            } else {
                alert("카테고리를 선택하세요.");
            }
        } catch (error) {
            console.error("서버 요청 중 오류 발생:", error);
            alert("오류가 발생했습니다.");
        }
    });
});
</script>